{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "bundler",
    "strict": true, "experimentalDecorators": true, "skipLibCheck": true,
    "isolatedModules": true, "lib": ["ES2022", "DOM"], "outDir": "../../dist/web-ts"

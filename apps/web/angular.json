{
  "$schema": "../../node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": { "analytics": false },
  "projects": {
    "caixa": {
      "projectType": "application", "root": "", "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist", "index": "src/index.html", "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json", "styles": ["src/styles.css"], "assets": []
          },
          "configurations": {
            "production": { "outputHashing": "all", "optimization": { "scripts": true, "styles": { "minify": true, "inlineCritical": false }, "fonts": false }, "budgets": [{ "type": "initial", "maximumWarning": "700kB", "maximumError": "1MB" }] },
            "development": { "optimization": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "caixa:build:production" },
            "development": { "buildTarget": "caixa:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
